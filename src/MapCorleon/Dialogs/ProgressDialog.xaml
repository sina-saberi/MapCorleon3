<Window x:Class="MapCorleon.Dialogs.ProgressDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Progress Categories" Width="420" Height="480" WindowStartupLocation="CenterOwner"><DockPanel Margin="16"><TextBlock DockPanel.Dock="Top" Text="Choose categories included in progress reporting. This does not change the main filter." TextWrapping="Wrap" Margin="4,4,4,12"/><Button DockPanel.Dock="Bottom" Content="Apply" HorizontalAlignment="Right" IsDefault="True" Click="Apply_Click"/><ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Name}" IsExpanded="True"><ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="True" Margin="8,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Window>
