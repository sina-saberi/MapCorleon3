<Window x:Class="MapCorleon.Dialogs.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Progress categories" Width="440" Height="560" MinWidth="380" MinHeight="380"
        WindowStartupLocation="CenterOwner">
  <Grid Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#172131" BorderBrush="#303C4E" BorderThickness="0,0,0,1" Padding="20,17">
      <StackPanel>
        <TextBlock Text="Progress categories" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Choose which categories are included in your completion progress. This does not change the map filter."
                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14,8,14">
      <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,6,0">
        <ItemsControl.ItemTemplate><DataTemplate>
          <Expander IsExpanded="True" Margin="0,0,0,8">
            <Expander.Header>
              <DockPanel Margin="2,7">
                <Border DockPanel.Dock="Right" Background="#22334B" CornerRadius="9" Padding="7,2" Margin="8,0,0,0">
                  <TextBlock Text="{Binding Categories.Count}" Foreground="#8EBDF7" FontSize="10"/>
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#D8E2EF"/>
              </DockPanel>
            </Expander.Header>
            <Border Background="#151E2A" BorderBrush="#2B394C" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,2,0,0">
              <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <CheckBox Content="{Binding Name}" IsChecked="True" Padding="2,5"/>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Expander>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#151B25" BorderBrush="#303C4E" BorderThickness="0,1,0,0" Padding="14,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" MinWidth="82"/>
        <Button Content="Apply" IsDefault="True" Click="Apply_Click" MinWidth="82" Background="#315B9C"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
