<Window x:Class="MapCorleon.Dialogs.TimelineDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Timeline &amp; Map Management" Width="520" Height="500" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="MAP" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><ComboBox x:Name="MapBox" ItemsSource="{Binding Maps}" SelectedItem="{Binding CurrentMap,Mode=OneWay}" SelectionChanged="Map_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button Content="Save changes" Click="Save_Click" Background="#315B9C"/></StackPanel></StackPanel>
  <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="TIMELINES" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
   <ListBox x:Name="TimelineList" Grid.Row="1" DisplayMemberPath="Name" Margin="3,6" SelectionChanged="Timeline_SelectionChanged"/>
   <StackPanel Grid.Row="2" Margin="3,8,3,0"><TextBlock Text="TIMELINE NAME" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><TextBox x:Name="NameBox"/></StackPanel>
   <UniformGrid Grid.Row="3" Columns="5"><Button Content="Add" Click="Add_Click"/><Button Content="Rename" Click="Edit_Click"/><Button Content="Remove" Click="Remove_Click"/><Button Content="Move up" Click="Up_Click"/><Button Content="Move down" Click="Down_Click"/></UniformGrid>
  </Grid>
 </DockPanel>
</Window>
