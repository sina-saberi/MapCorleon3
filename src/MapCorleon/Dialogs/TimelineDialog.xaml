<Window x:Class="MapCorleon.Dialogs.TimelineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timelines" Width="560" Height="500"
        MinWidth="460" MinHeight="340" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="TimelineCardButton" TargetType="Button">
      <Setter Property="Background" Value="#19212E"/>
      <Setter Property="BorderBrush" Value="#303D50"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="15,12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CardBorder" Property="Background" Value="#233045"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#91B9F5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter Property="Background" Value="#1B2C42"/>
          <Setter Property="BorderBrush" Value="#4C78A8"/>
          <Setter Property="AutomationProperties.ItemStatus" Value="Selected"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <DockPanel x:Name="DialogContent" Margin="20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add timeline"
              Click="Add_Click" Background="#315B9C" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <StackPanel>
        <TextBlock Text="Playthroughs" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding CurrentMap.Name, TargetNullValue=No map selected, FallbackValue=No map selected}"
                   Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
      </StackPanel>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="EmptyMessage" Text="No timelines for this map." Margin="0,8"
                   Foreground="{StaticResource MutedTextBrush}"/>
        <ItemsControl x:Name="TimelineCards">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,10">
                <Button Style="{StaticResource TimelineCardButton}" Click="Activate_Click"
                        AutomationProperties.Name="{Binding Timeline.Name}">
                  <StackPanel>
                    <Grid Margin="0,0,74,10" MinHeight="26">
                      <TextBlock Text="{Binding Timeline.Name}" FontSize="15" FontWeight="SemiBold"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Percentage,StringFormat={}{0}%}"
                                 Foreground="#B8C9DF" FontSize="12" TextAlignment="Right" MinWidth="39" Margin="10,0,0,0"/>
                      <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding Percentage,Mode=OneWay}"
                                   VerticalAlignment="Center" AutomationProperties.Name="Timeline progress">
                        <ProgressBar.Template>
                          <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track">
                              <Border Background="#101A28" CornerRadius="2.5"/>
                              <Border x:Name="PART_Indicator" Background="#83B1F0" CornerRadius="2.5"
                                      HorizontalAlignment="Left"/>
                            </Grid>
                          </ControlTemplate>
                        </ProgressBar.Template>
                      </ProgressBar>
                    </DockPanel>
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,9,0">
                  <Button Style="{StaticResource IconAction}" Click="Edit_Click" ToolTip="Rename timeline"
                          AutomationProperties.Name="Rename timeline" Width="30" Height="30">
                    <Path Data="M4,13 L4,17 8,17 17,8 13,4 Z M11,6 L15,10"
                          Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeLineJoin="Round"/>
                  </Button>
                  <Button Style="{StaticResource IconAction}" Click="Delete_Click" ToolTip="Delete timeline"
                          AutomationProperties.Name="Delete timeline" Width="30" Height="30"
                          Visibility="{Binding CanDelete,Converter={StaticResource BoolToVisibility}}">
                    <Path Data="M4,6 H16 M6,6 L7,17 H13 L14,6 M8,6 V4 H12 V6 M9,9 V14 M11,9 V14"
                          Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
