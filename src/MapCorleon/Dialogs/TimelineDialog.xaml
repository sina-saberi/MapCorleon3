<Window x:Class="MapCorleon.Dialogs.TimelineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maps &amp; Timelines" Width="600" Height="700"
        MinHeight="560" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="MAP" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
            <ComboBox x:Name="MapBox" ItemsSource="{Binding Maps}" SelectedItem="{Binding CurrentMap,Mode=OneWay}"
                SelectionChanged="Map_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <Separator Margin="0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True"/>
                <Button Content="Save changes" Click="Save_Click" Background="#315B9C"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>
                <Border CornerRadius="5" Padding="12" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="TIMELINES" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        <ListBox x:Name="TimelineList" DisplayMemberPath="Name" Height="180" Margin="3,6"
                 SelectionChanged="Timeline_SelectionChanged"/>
                        <StackPanel Margin="3,8,3,0">
                            <TextBlock Text="TIMELINE NAME" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                            <TextBox x:Name="NameBox"/>
                        </StackPanel>
                        <UniformGrid Columns="5">
                            <Button Content="Add" Click="Add_Click"/>
                            <Button Content="Rename" Click="Edit_Click"/>
                            <Button Content="Remove" Click="Remove_Click"/>
                            <Button Content="Move up" Click="Up_Click"/>
                            <Button Content="Move down" Click="Down_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border x:Name="GameSettingsPanel" Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         CornerRadius="5" Padding="12" Margin="3,20,3,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="SKYRIM PLAYER TRACKING" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        <TextBlock Text="These launch settings belong only to the selected Skyrim map. Tracking always attaches to SkyrimSE.exe." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                        <TextBlock Text="Launch executable"/>
                        <DockPanel Margin="0,4,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseExecutable_Click"/>
                            <TextBox x:Name="LaunchExecutableBox"/>
                        </DockPanel>
                        <TextBlock Text="Arguments (optional)"/>
                        <TextBox x:Name="LaunchArgumentsBox" Margin="0,4,0,8"/>
                        <TextBlock Text="Working directory (optional)"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseWorkingDirectory_Click"/>
                            <TextBox x:Name="LaunchWorkingDirectoryBox"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
