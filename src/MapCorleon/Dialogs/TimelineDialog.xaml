<Window x:Class="MapCorleon.Dialogs.TimelineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timelines" Width="600" Height="540"
        MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner">
  <Grid x:Name="DialogContent" Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding CurrentMap.DisplayName, TargetNullValue=No map selected}"
               Foreground="{StaticResource MutedTextBrush}" Margin="3,0"/>
    <DockPanel Grid.Row="1" Margin="3,14,3,8">
      <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add timeline"
              Click="Add_Click" Background="#315B9C"/>
      <TextBlock Text="Timelines" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="EmptyMessage" Text="No timelines for this map." Margin="3,8"
                   Foreground="{StaticResource MutedTextBrush}"/>
        <ItemsControl x:Name="TimelineCards">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="5" Padding="10" Margin="3,0,3,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Button Click="Activate_Click" HorizontalContentAlignment="Stretch" Margin="0,0,8,0"
                          AutomationProperties.Name="{Binding Timeline.Name}" ToolTip="Use this timeline for map progress">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Percentage,StringFormat={}{0}%}"
                                   Foreground="#A8C8EE" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <ProgressBar Height="5" Minimum="0" Maximum="100" Margin="0,7,0,0"
                                   Value="{Binding Percentage,Mode=OneWay}"/>
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" Content="Edit" Click="Edit_Click"/>
                  <Button Grid.Column="2" Content="Delete" Click="Delete_Click"
                          Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="3" Content="Close" IsCancel="True" MinWidth="78"
            HorizontalAlignment="Right" Margin="3,12,3,0"/>
  </Grid>
</Window>
