<Window x:Class="MapCorleon.Dialogs.TimelineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maps &amp; Timelines" Width="600" Height="540"
        MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <DockPanel Background="Transparent">
              <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse x:Name="Ring" Fill="{StaticResource WindowBrush}" Stroke="#65748A" StrokeThickness="1.5"/>
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#9CC6FF" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="#79A8E8"/>
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="#D1E4FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="DialogContent" Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Map" Foreground="{StaticResource MutedTextBrush}"/>
      <ComboBox x:Name="MapBox" ItemsSource="{Binding Maps}" SelectedItem="{Binding CurrentMap, Mode=OneWay}"
                SelectionChanged="Map_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="3,14,3,8">
      <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add timeline"
              Click="Add_Click" Background="#315B9C"/>
      <TextBlock Text="Timelines" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="EmptyMessage" Text="No timelines for this map." Margin="3,8"
                   Foreground="{StaticResource MutedTextBrush}"/>
        <ItemsControl x:Name="TimelineCards">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="5" Padding="10" Margin="3,0,3,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <RadioButton GroupName="ActiveTimeline"
                               IsChecked="{Binding IsActive, Mode=OneWay}" Click="Activate_Click"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="Use this timeline for map progress">
                    <TextBlock Text="{Binding Timeline.Name}" TextTrimming="CharacterEllipsis"/>
                  </RadioButton>
                  <Button Grid.Column="1" Content="Edit" Click="Edit_Click"/>
                  <Button Grid.Column="2" Content="Delete" Click="Delete_Click"
                          Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="3" Content="Close" IsCancel="True" MinWidth="78"
            HorizontalAlignment="Right" Margin="3,12,3,0"/>
  </Grid>
</Window>
