<Window x:Class="MapCorleon.Dialogs.LocationEditorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Custom Location" Width="600" Height="680" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Title"/><TextBox x:Name="TitleBox"/><TextBlock Text="Description (Markdown and links supported)"/><TextBox x:Name="DescriptionBox" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Category"/><ComboBox x:Name="CategoryBox" DisplayMemberPath="Name"/><TextBlock Text="Images"/><ListBox x:Name="ImagesBox" Height="100"/><Button Content="Add multiple images…" HorizontalAlignment="Left" Click="Images_Click"/><TextBlock Text="Coordinates" Margin="3,8,3,0"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="Latitude"/><TextBox x:Name="LatitudeBox"/></StackPanel><StackPanel><TextBlock Text="Longitude"/><TextBox x:Name="LongitudeBox"/></StackPanel></UniformGrid><Button Content="◎  Pick position on map" Click="PickOnMap_Click" Background="#315B9C" Padding="12,10"/><TextBlock Text="This location belongs to the active timeline. The editor will hide while you pick its map position." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="3"/></StackPanel><DockPanel Grid.Row="1"><Button x:Name="DeleteButton" DockPanel.Dock="Left" Content="Delete location" Click="Delete_Click" Background="#6B2630" Visibility="Collapsed"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save" Click="Save_Click"/></StackPanel></DockPanel></Grid></Window>
