<Window x:Class="MapCorleon.Dialogs.LocationEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Location" Width="640" Height="620" MinWidth="580" MinHeight="560"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8295AD"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="1,0,1,7"/>
    </Style>
    <Style x:Key="EditorButton" TargetType="Button">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="13,8"/>
    </Style>
    <Style x:Key="PrimaryEditorButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
      <Setter Property="Background" Value="#3472C4"/>
      <Setter Property="BorderBrush" Value="#5687D1"/>
      <Setter Property="MinWidth" Value="92"/>
    </Style>
    <Style x:Key="SecondaryEditorButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
      <Setter Property="Background" Value="#26364B"/>
      <Setter Property="BorderBrush" Value="#465B76"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#F0F5FC"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinWidth" Value="82"/>
    </Style>
  </Window.Resources>

  <Grid Background="#101721">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" BorderBrush="#2A3A50" BorderThickness="0,0,0,1" Padding="22,18">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#17263A" Offset="0"/>
          <GradientStop Color="#121D2D" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Width="38" Height="38" CornerRadius="9" Background="#2D64AA" VerticalAlignment="Center">
          <Path Data="M12,21 C12,21 5,14.5 5,9 A7,7 0 1 1 19,9 C19,14.5 12,21 12,21 Z M12,6 L12,12 M9,9 L15,9"
                Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                StrokeLineJoin="Round" Stretch="Uniform" Width="21" Height="21"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="DialogHeading" Text="Add custom location" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock x:Name="DialogSubtitle" Text="Create a personal marker at the selected map position."
                     Foreground="#8EA2BA" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="22,18,22,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,15">
        <TextBlock Text="TITLE" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TitleBox" Margin="0" Padding="11,9" FontSize="13"/>
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="0,0,0,15">
        <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="DescriptionBox" Height="104" Margin="0" Padding="11,9" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="Markdown and links are supported." Foreground="#71849B" FontSize="10" Margin="2,5,0,0"/>
      </StackPanel>

      <Grid Grid.Row="2" Margin="0,0,0,15">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" Margin="0"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="MAP POSITION" Style="{StaticResource FieldLabel}"/>
          <Border Height="36" Background="#18263A" BorderBrush="#2C4565" BorderThickness="1" CornerRadius="4">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="◉" Foreground="#79B7FA" FontSize="15" Margin="0,0,7,0"/>
                <TextBlock Text="Selected" Foreground="#C9D7E8" FontSize="11" VerticalAlignment="Center"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Pick again" Click="PickAgain_Click" Style="{StaticResource EditorButton}"
                      Background="Transparent" BorderThickness="0" Foreground="#8FC4FF" Padding="10,0"/>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="3">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,7">
          <Button DockPanel.Dock="Right" Content="+  Add images" Click="Images_Click"
                  Style="{StaticResource EditorButton}" Background="Transparent" BorderThickness="0"
                  Foreground="#8FC4FF" Padding="9,4"/>
          <TextBlock Text="IMAGES" Style="{StaticResource FieldLabel}" Margin="1,5,1,0"/>
        </DockPanel>
        <Border Grid.Row="1" Background="#131C28" BorderBrush="#2A394D" BorderThickness="1" CornerRadius="5" MinHeight="70">
          <Grid>
            <TextBlock Text="No images selected" Foreground="#657990" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Items.Count,ElementName=ImagesBox}" Value="0">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ListBox x:Name="ImagesBox" Margin="4" Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FileName}" Foreground="#C8D5E5" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" ToolTip="{Binding FilePath}"/>
                    <Button Grid.Column="1" Content="×" Width="26" Height="24" Padding="0" Margin="8,0,0,0"
                            Background="Transparent" BorderThickness="0" Foreground="#8FA3BA"
                            ToolTip="Remove image" Click="RemoveImage_Click" CommandParameter="{Binding}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#121A25" BorderBrush="#2A394D" BorderThickness="0,1,0,0" Padding="22,12">
      <DockPanel>
        <Button x:Name="DeleteButton" DockPanel.Dock="Left" Content="Delete location" Click="Delete_Click"
                Style="{StaticResource EditorButton}" Background="#542831" BorderBrush="#7A3947"
                Foreground="#F2A7B0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryEditorButton}" Margin="0,0,8,0"/>
          <Button Content="Save location" Click="Save_Click" Style="{StaticResource PrimaryEditorButton}"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
