<Window x:Class="MapCorleon.Dialogs.MapPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Games and Maps" Width="800" Height="650" MinWidth="500" MinHeight="390"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <Button x:Name="BackButton" Content="Back to games" Click="Back_Click" Visibility="Collapsed"
              DockPanel.Dock="Right" Margin="12,0,0,0"/>
      <TextBlock x:Name="Heading" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    <Button x:Name="LocalMapButton" DockPanel.Dock="Bottom" Content="Add Sedletz from installed KCD2"
            Click="LocalMap_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
    <TextBlock x:Name="Empty" DockPanel.Dock="Top" Foreground="{StaticResource MutedTextBrush}"
               Text="No maps available." Visibility="Collapsed"/>
    <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Cards">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="226" Margin="0,0,12,12" Padding="0" HorizontalContentAlignment="Stretch"
                    Click="Card_Click" AutomationProperties.Name="{Binding Name}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="105"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="#202F44" ClipToBounds="True">
                  <Grid>
                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="32" Foreground="{StaticResource MutedTextBrush}"/>
                    <Image Source="{Binding Artwork}" Stretch="UniformToFill"/>
                  </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="12,8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
