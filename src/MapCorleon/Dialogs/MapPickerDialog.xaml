<Window x:Class="MapCorleon.Dialogs.MapPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MapCorleon.Dialogs"
        Title="Games and Maps" Width="800" Height="650" MinWidth="500" MinHeight="390"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
  <DockPanel Margin="0,20,0,20">
    <DockPanel DockPanel.Dock="Top" Margin="20,0,20,14">
      <Button x:Name="BackButton" Click="Back_Click" Visibility="Collapsed" DockPanel.Dock="Left"
              Style="{StaticResource IconAction}" ToolTip="Back to games" AutomationProperties.Name="Back to games"
              Margin="-4,0,8,0">
        <Path Data="M14,5 L7,12 14,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Button>
      <TextBlock x:Name="Heading" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock x:Name="Empty" DockPanel.Dock="Top" Foreground="{StaticResource MutedTextBrush}"
               Text="No maps available." Visibility="Collapsed" Margin="20,0"/>
    <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.Template>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="1"
                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="2" HorizontalAlignment="Center"
                       Orientation="Vertical" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{TemplateBinding VerticalOffset}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
          </Grid>
        </ControlTemplate>
      </ScrollViewer.Template>
      <ItemsControl x:Name="Cards">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><local:PickerCardPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Margin="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Click="Card_Click" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
              <StackPanel>
                <Border Background="#1B2738">
                  <Viewbox Stretch="Uniform">
                    <Grid Width="240" Height="112">
                      <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 FontSize="32" Foreground="{StaticResource MutedTextBrush}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Artwork}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Image Source="{Binding Artwork}" Stretch="Uniform" VerticalAlignment="Top"/>
                    </Grid>
                  </Viewbox>
                </Border>
                <StackPanel Margin="12,8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
