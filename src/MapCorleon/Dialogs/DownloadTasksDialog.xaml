<Window x:Class="MapCorleon.Dialogs.DownloadTasksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Tasks" Width="720" Height="600" MinWidth="580" MinHeight="420"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closed="Window_Closed">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="3,0,3,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Refresh" Click="Refresh_Click"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="DOWNLOAD TASKS" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
        <TextBlock Text="Only one task runs at a time. Starting another task automatically pauses the active task."
                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,12,0"/>
      </StackPanel>
    </DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
            Padding="10" Margin="3,0,3,12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="MapBox" MinWidth="300" Margin="0,0,10,0">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
          <CheckBox x:Name="AddMedia" Content="Media" IsChecked="True" Margin="2,0,14,0"/>
          <CheckBox x:Name="AddTiles" Content="Tiles" Margin="2,0"/>
        </StackPanel>
        <Button x:Name="AddButton" Grid.Column="2" Content="Add to queue" Click="AddTask_Click"
                VerticalAlignment="Stretch" Margin="0" MinWidth="110"/>
        <TextBlock x:Name="AddStatus" Grid.Row="1" Grid.ColumnSpan="3" Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap" Margin="0,7,0,0" Visibility="Collapsed"/>
      </Grid>
    </Border>
    <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" HorizontalAlignment="Right" Margin="3,12,3,3"/>
    <ListBox x:Name="TaskList" BorderThickness="0" Padding="0">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0,0,0,8"/>
          <Setter Property="Background" Value="Transparent"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding MapDisplayName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0">
                  <Run Text="{Binding DownloadKinds, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Status, Mode=OneWay}"/>
                </TextBlock>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{Binding ActionText, Mode=OneWay}" IsEnabled="{Binding CanAct, Mode=OneWay}"
                        Visibility="{Binding CanAct,Converter={StaticResource BoolToVisibility}}"
                        Tag="{Binding Id, Mode=OneWay}" Click="TaskAction_Click" MinWidth="88"/>
                <Button Content="Cancel &amp; remove" Tag="{Binding Id, Mode=OneWay}"
                        Click="CancelTask_Click" Background="#6B2630"/>
              </StackPanel>
              <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                           Value="{Binding Percentage, Mode=OneWay}" Height="7" Margin="0,13,0,7"/>
              <DockPanel Grid.Row="2" Grid.ColumnSpan="2">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Percentage, Mode=OneWay, StringFormat={}{0}%}"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="{Binding ProgressText, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/>
              </DockPanel>
              <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Error, Mode=OneWay}" Foreground="#F0A0A8"
                         TextWrapping="Wrap" Margin="0,7,0,0"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
