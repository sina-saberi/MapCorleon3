<Window x:Class="MapCorleon.Dialogs.DownloadTasksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Manager" Width="720" Height="600" MinWidth="580" MinHeight="420"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closed="Window_Closed">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="3,0,3,12">
      <Button x:Name="ChooseMapButton" Content="Choose a map to download" Click="ChooseMap_Click"
              HorizontalAlignment="Left" Margin="0,0,0,8"/>
      <Border x:Name="DownloadOptions" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
        <StackPanel>
          <TextBlock x:Name="SelectedMapName" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <DockPanel>
            <Button x:Name="AddButton" Content="Start download" Click="AddTask_Click"
                    DockPanel.Dock="Right" MinWidth="110" Margin="0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <CheckBox x:Name="AddTiles" Content="Tiles" Margin="0,0,14,0"/>
              <CheckBox x:Name="AddMedia" Content="Media" IsChecked="True"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
      <TextBlock x:Name="AddStatus" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                 Margin="0,7,0,0" Visibility="Collapsed"/>
    </StackPanel>
    <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" HorizontalAlignment="Right" Margin="3,12,3,3"/>
    <ListBox x:Name="TaskList" BorderThickness="0" Padding="0">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0,0,0,8"/>
          <Setter Property="Background" Value="Transparent"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding MapDisplayName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0">
                  <Run Text="{Binding DownloadKinds, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Status, Mode=OneWay}"/>
                </TextBlock>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{Binding ActionText, Mode=OneWay}" IsEnabled="{Binding CanAct, Mode=OneWay}"
                        Visibility="{Binding CanAct,Converter={StaticResource BoolToVisibility}}"
                        Tag="{Binding Id, Mode=OneWay}" Click="TaskAction_Click" MinWidth="88"/>
                <Button Content="Cancel &amp; remove" Tag="{Binding Id, Mode=OneWay}"
                        Click="CancelTask_Click" Background="#6B2630"/>
              </StackPanel>
              <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                           Value="{Binding Percentage, Mode=OneWay}" Height="7" Margin="0,13,0,7"/>
              <DockPanel Grid.Row="2" Grid.ColumnSpan="2">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Percentage, Mode=OneWay, StringFormat={}{0}%}"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="{Binding ProgressText, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/>
              </DockPanel>
              <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Error, Mode=OneWay}" Foreground="#F0A0A8"
                         TextWrapping="Wrap" Margin="0,7,0,0"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
