<Window x:Class="MapCorleon.Dialogs.MediaViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image gallery" Width="1100" Height="760" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#05070A" ClipToBounds="True">
      <Image x:Name="MainImage" Stretch="Uniform"/>
    </Border>
    <ListBox x:Name="Filmstrip" Grid.Row="1" Height="92" Margin="0,10,0,0"
             SelectionChanged="Filmstrip_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Image thumbnails">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate><Image Source="{Binding RelativePath}" Width="100" Height="68" Stretch="UniformToFill"/></DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
