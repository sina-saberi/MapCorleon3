<Window x:Class="MapCorleon.Dialogs.MediaViewerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Image gallery" Width="1100" Height="760" MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#090D13" KeyDown="Window_KeyDown">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="16,12"><Button DockPanel.Dock="Right" Content="Close" IsCancel="True"/><StackPanel><TextBlock x:Name="CaptionText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="PositionText" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Margin="16,0" Background="#05070A" ClipToBounds="True"><Image x:Name="MainImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border>
  <DockPanel Grid.Row="2" Margin="16,10"><TextBlock DockPanel.Dock="Right" Text="Use thumbnails or left/right arrow keys to switch images" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><Button Content="Save a copy…" HorizontalAlignment="Left" Click="Save_Click"/></DockPanel>
  <ListBox x:Name="Filmstrip" Grid.Row="3" Height="92" Margin="16,0,16,14" SelectionChanged="Filmstrip_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Image Source="{Binding RelativePath}" Width="100" Height="68" Stretch="UniformToFill"/></DataTemplate></ListBox.ItemTemplate></ListBox>
 </Grid>
</Window>
