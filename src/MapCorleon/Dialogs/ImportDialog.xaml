<Window x:Class="MapCorleon.Dialogs.ImportDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Import MapGenie Map" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"><StackPanel Margin="20" Width="560"><TextBlock Text="Game name"/><TextBox x:Name="GameName"/><TextBlock Text="Map JSON file"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseMap_Click"/><TextBox x:Name="MapPath" IsReadOnly="True"/></DockPanel><TextBlock Text="Sprite JSON file or URL (the matching .png is detected automatically)"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseSprite_Click"/><TextBox x:Name="SpritePath"/></DockPanel><TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="3,10"/><ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="7" Visibility="Collapsed"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"/><Button x:Name="SubmitButton" Content="Import" Click="Submit_Click"/></StackPanel></StackPanel></Window>
