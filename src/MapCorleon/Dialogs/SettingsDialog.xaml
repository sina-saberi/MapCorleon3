<Window x:Class="MapCorleon.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <DockPanel>
              <ItemsPresenter DockPanel.Dock="Top" Margin="0,0,0,6" KeyboardNavigation.TabNavigation="Once"/>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                  <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                </ScrollViewer>
              </Border>
            </DockPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabChrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource RaisedBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter TargetName="TabChrome" Property="Background" Value="#30476B"/>
                <Setter TargetName="TabChrome" Property="BorderBrush" Value="#5687D1"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TabChrome" Property="BorderBrush" Value="#A9CDFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <StackPanel x:Name="DialogContent" Margin="20" Width="560">
    <TabControl>
      <TabItem Header="General">
        <StackPanel Margin="12">
          <TextBlock Text="Data directory"/>
          <DockPanel Margin="0,4,0,8">
            <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click"/>
            <TextBox x:Name="DataDirectory"/>
          </DockPanel>
          <TextBlock Text="The database, permanent tile cache, downloaded media, and provider assets are stored below this directory."
                     Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
          <TextBlock Text="Changing this directory takes effect after restarting MapCorleon. Existing data is not moved automatically."
                     Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
      </TabItem>
      <TabItem x:Name="GameLaunchTab" Header="Game launch" Visibility="Collapsed">
        <StackPanel Margin="12">
          <TextBlock x:Name="LaunchMapName" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="LaunchDescription" Foreground="{StaticResource MutedTextBrush}"
                     TextWrapping="Wrap" Margin="0,5,0,12"/>
          <TextBlock Text="Launch executable"/>
          <DockPanel Margin="0,4,0,8">
            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseExecutable_Click"/>
            <TextBox x:Name="LaunchExecutableBox"/>
          </DockPanel>
          <TextBlock Text="Arguments (optional)"/>
          <TextBox x:Name="LaunchArgumentsBox" Margin="0,4,0,8"/>
          <TextBlock Text="Working directory (optional)"/>
          <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseWorkingDirectory_Click"/>
            <TextBox x:Name="LaunchWorkingDirectoryBox"/>
          </DockPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="Game overlay">
        <StackPanel Margin="12">
          <TextBlock x:Name="OverlayMapName" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <TextBlock x:Name="OverlayUnavailable" Foreground="{StaticResource MutedTextBrush}"
                     TextWrapping="Wrap" Visibility="Collapsed"/>
          <StackPanel x:Name="OverlayOptions">
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Nearby radius (Skyrim units)"/>
                <TextBox x:Name="NearbyRadius" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Nearby notification duration (seconds)"/>
                <TextBox x:Name="NotificationSeconds" Margin="0,4,0,0"/>
              </StackPanel>
            </UniformGrid>
            <CheckBox x:Name="CustomKeys" Content="Set keybindings in MapCorleon" Margin="0,12,0,4"/>
            <UniformGrid Columns="2" IsEnabled="{Binding IsChecked, ElementName=CustomKeys}">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Open overlay panel"/>
                <ComboBox x:Name="PanelKey" DisplayMemberPath="Name" SelectedValuePath="ScanCode" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Toggle Follow Player"/>
                <ComboBox x:Name="FollowKey" DisplayMemberPath="Name" SelectedValuePath="ScanCode" Margin="0,4,0,0"/>
              </StackPanel>
            </UniformGrid>
            <TextBlock Text="Choose two different function keys. When unchecked, the plugin uses its INI bindings."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
            <TextBlock Text="Categories shown in alerts and the nearby panel"/>
            <TextBlock x:Name="CategoryStatus" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                       Margin="0,4,0,0" Visibility="Collapsed"/>
            <ItemsControl x:Name="CategoryList" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" Margin="0,2"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" IsCancel="True"/>
      <Button Content="Save" Click="Save_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
