<Window x:Class="MapCorleon.Dialogs.TimelineNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="400" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16">
    <TextBlock Text="Timeline name"/>
    <TextBox x:Name="TimelineNameBox" Margin="0,6,0,10" TextChanged="TimelineName_Changed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True"/>
      <Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="Save_Click" Background="#315B9C"/>
    </StackPanel>
  </StackPanel>
</Window>
