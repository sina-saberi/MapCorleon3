<UserControl x:Class="MapCorleon.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf">
  <UserControl.Resources>
    <SolidColorBrush x:Key="FollowingBrush" Color="#315B9C"/>
    <SolidColorBrush x:Key="FollowPausedBrush" Color="#624A26"/>
  </UserControl.Resources>
  <Grid Background="#111923">
    <mapsui:MapControl x:Name="MapControl" Focusable="True"/>
    <Border x:Name="PickHint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12"
            Padding="12,8" Background="#E6315B9C" BorderBrush="#7FB4F3" BorderThickness="1"
            CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="+" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,8,0"/>
        <TextBlock Text="Click the map to place the location  •  Esc to cancel"
                   Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Button x:Name="FollowPlayerButton" Style="{StaticResource IconAction}"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="38" Height="38"
            Margin="16" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
            Click="FollowPlayer_Click" IsEnabled="False"
            ToolTip="Follow player" AutomationProperties.Name="Follow player">
      <Grid>
        <Path x:Name="FollowTargetIcon" Style="{StaticResource OutlineActionIcon}"
              Data="M12,2 V6 M12,18 V22 M2,12 H6 M18,12 H22 M18,12 A6,6 0 1 1 6,12 A6,6 0 1 1 18,12 M13.5,12 A1.5,1.5 0 1 1 10.5,12 A1.5,1.5 0 1 1 13.5,12"/>
        <Path x:Name="FollowPausedIcon" Style="{StaticResource OutlineActionIcon}" Visibility="Collapsed"
              Data="M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 M10,8 V16 M14,8 V16"/>
      </Grid>
    </Button>
  </Grid>
</UserControl>
