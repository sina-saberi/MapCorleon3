<Window x:Class="MapCorleon.Views.DesktopGameOverlayWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MapCorleon nearby locations" Width="320" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" Left="-32000" Top="-32000">
  <StackPanel>
    <Border x:Name="PanelHeader" Padding="12,5" Margin="0,0,0,4" CornerRadius="6"
            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="×" ToolTip="Close overlay" AutomationProperties.Name="Close overlay"
                Padding="10,5" Click="ClosePanel_Click"/>
        <TextBlock Text="Nearby locations" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <Border x:Name="MessageFrame" Padding="12,8" Margin="0,0,0,4" CornerRadius="6"
            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
    </Border>
    <ItemsControl x:Name="LocationCards">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                          Visibility="{Binding IsInteractive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <Button Content="Collect" Click="Collect_Click" Padding="10,4"/>
                <Button Content="×" ToolTip="Dismiss location" AutomationProperties.Name="Dismiss location"
                        Click="Dismiss_Click" Padding="10,4"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</Window>
