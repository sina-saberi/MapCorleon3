<UserControl x:Class="MapCorleon.Views.LeftSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SegmentButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="#AAB8CA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#263347"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#315B9C"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="GroupChevron" Height="28" Cursor="Hand"
                                          IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"
                                          ToolTip="Expand or collapse group" AutomationProperties.Name="Expand or collapse group">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HitArea" Background="Transparent" CornerRadius="4">
                                            <Path x:Name="Chevron" Data="M3,2 L7,6 L3,10" Width="10" Height="12"
                                                  Stroke="#9CAFC7" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HitArea" Property="Background" Value="#263347"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HitArea" Property="Background" Value="#263347"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Grid.Column="1" ContentSource="Header"/>
                            <ContentPresenter x:Name="GroupContent" Grid.Row="1" Grid.ColumnSpan="2"
                                              ContentSource="Content" Margin="0,2,0,4" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="GroupContent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#121923" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,9" BorderBrush="#2A3749" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#182437" Offset="0"/>
                        <GradientStop Color="#131C29" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="#22334B" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalCount,StringFormat={}{0:N0}}" Foreground="#9CC7FF" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentGameName}" FontSize="15" FontWeight="SemiBold" Foreground="White"
                               Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="12,12,12,8">
                <TextBox x:Name="SearchBox" Margin="0" Padding="34,9,36,9" Background="#192230"
                 Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search locations, categories, and groups"/>
                <TextBlock Text="⌕" FontSize="18" Foreground="#7588A0" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Margin="34,0,38,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#71839A" Text="Search locations and categories…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="×" Width="28" Height="28" Padding="0" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearSearch_Click" ToolTip="Clear search"
                Visibility="{Binding IsSearchActive,Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <StackPanel x:Name="BrowseControls" Grid.Row="2" Margin="12,0,12,10">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchActive}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="#192230" BorderBrush="#2B394D" BorderThickness="1" CornerRadius="6" Padding="3">
                    <UniformGrid Columns="3">
                        <ToggleButton Content="All" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsAllFilter,Mode=OneWay}" Command="{Binding ShowAllCommand}"/>
                        <ToggleButton Content="Marked" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsMarkedFilter,Mode=OneWay}" Command="{Binding ShowMarkedCommand}"/>
                        <ToggleButton Content="Unmarked" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsUnmarkedFilter,Mode=OneWay}" Command="{Binding ShowUnmarkedCommand}"/>
                    </UniformGrid>
                </Border>

                <Button Click="Progress_Click" Margin="0,10,0,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <Border Background="#18263A" BorderBrush="#2C4565" BorderThickness="1" CornerRadius="6" Padding="11,9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="View ›" Foreground="#83B8F8" FontSize="11"/>
                                <TextBlock Text="{Binding ProgressSummary}" Foreground="#C8D6E8" FontSize="12" FontWeight="SemiBold"/>
                            </DockPanel>
                            <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="4" Margin="0,7,0,0"/>
                        </Grid>
                    </Border>
                </Button>
            </StackPanel>

            <Border Grid.Row="3" Margin="12,0,12,12" Background="#171F2B" BorderBrush="#2A374A" BorderThickness="1" CornerRadius="6">
                <ScrollViewer Margin="4,3,0,3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Width" Value="8"/>
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="0,0,3,0">
                        <ItemsControl ItemsSource="{Binding CategoryGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Style="{StaticResource GroupExpander}" IsExpanded="True">
                                        <Expander.Header>
                                            <Button Padding="4,0" Margin="0" Background="Transparent" BorderThickness="0"
                                                    FontWeight="SemiBold" Foreground="#D8E2EF" HorizontalContentAlignment="Left"
                                                    ToolTip="Show or hide all categories in this group"
                                                    AutomationProperties.Name="{Binding Name,StringFormat=Toggle categories in {0}}"
                                                    Command="{Binding DataContext.ToggleGroupCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Group}">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Categories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="9,0,4,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Padding="0,5" IsChecked="{Binding IsVisible,Mode=TwoWay}"
                                                                  Command="{Binding DataContext.ToggleCategoryCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        </CheckBox>
                                                        <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{Binding ProgressText}"
                                                                   Foreground="#8EA6C2" FontSize="11" VerticalAlignment="Center"
                                                                   ToolTip="Marked / total locations"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsSearchActive,Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="2,0,2,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SearchResults.Count,StringFormat={}{0} found}" Foreground="#6F829A" FontSize="11"/>
                                <TextBlock Text="SEARCH RESULTS" Foreground="#7F91A8" FontSize="10" FontWeight="SemiBold"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch" Padding="10,9" Margin="0,0,0,5"
                            Command="{Binding DataContext.SelectCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding Category.Name}" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="›" Foreground="#7EAEED" FontSize="18" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
