<UserControl x:Class="MapCorleon.Views.LeftSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SegmentButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="#AAB8CA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#263347"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#315B9C"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="#171F2B" BorderBrush="#2A374A" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent}}"
                          Background="Transparent" BorderThickness="0" Padding="10,9" HorizontalContentAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderChrome" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <Grid >
                                                    <Grid.ColumnDefinitions >
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="#8192A8" StrokeThickness="1.4"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Width="5" Height="9" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5" Margin="4,0,0,0">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="ChevronRotation" Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter Grid.Column="1" ContentSource="Content" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderChrome" Property="Background" Value="#202B3B"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle"
                                                                                 To="90" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle"
                                                                                 To="0" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                </ToggleButton>
                                <Border x:Name="ContentSite" Grid.Row="1" Padding="6,0,6,7" Opacity="0" IsHitTestVisible="False">
                                    <Border.LayoutTransform>
                                        <ScaleTransform x:Name="ContentScale" ScaleY="0.001"/>
                                    </Border.LayoutTransform>
                                    <ContentPresenter ContentSource="Content"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentSite" Property="IsHitTestVisible" Value="True"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ContentSite" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.001" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ContentSite" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#121923" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,15,16,13" BorderBrush="#2A3749" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#182437" Offset="0"/>
                        <GradientStop Color="#131C29" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="#22334B" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalCount,StringFormat={}{0:N0}}" Foreground="#9CC7FF" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Browse locations" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{Binding CurrentMap.Name,TargetNullValue=Choose a map}" Foreground="#8295AD" FontSize="11" Margin="0,3,8,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="12,12,12,8">
                <TextBox x:Name="SearchBox" Margin="0" Padding="34,9,36,9" Background="#192230"
                 Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search locations, categories, and groups"/>
                <TextBlock Text="⌕" FontSize="18" Foreground="#7588A0" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Margin="34,0,38,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#71839A" Text="Search locations and categories…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="×" Width="28" Height="28" Padding="0" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearSearch_Click" ToolTip="Clear search"
                Visibility="{Binding IsSearchActive,Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <StackPanel x:Name="BrowseControls" Grid.Row="2" Margin="12,0,12,10">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchActive}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="#192230" BorderBrush="#2B394D" BorderThickness="1" CornerRadius="6" Padding="3">
                    <UniformGrid Columns="3">
                        <ToggleButton Content="All" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsAllFilter,Mode=OneWay}" Command="{Binding ShowAllCommand}"/>
                        <ToggleButton Content="Marked" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsMarkedFilter,Mode=OneWay}" Command="{Binding ShowMarkedCommand}"/>
                        <ToggleButton Content="Unmarked" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsUnmarkedFilter,Mode=OneWay}" Command="{Binding ShowUnmarkedCommand}"/>
                    </UniformGrid>
                </Border>

                <Button Click="Progress_Click" Margin="0,10,0,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <Border Background="#18263A" BorderBrush="#2C4565" BorderThickness="1" CornerRadius="6" Padding="11,9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="View ›" Foreground="#83B8F8" FontSize="11"/>
                                <TextBlock Text="{Binding ProgressSummary}" Foreground="#C8D6E8" FontSize="12" FontWeight="SemiBold"/>
                            </DockPanel>
                            <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="4" Margin="0,7,0,0"/>
                        </Grid>
                    </Border>
                </Button>

                <DockPanel Margin="2,14,2,2">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CategoryGroups.Count,StringFormat={}{0} groups}" Foreground="#65778E" FontSize="10"/>
                    <TextBlock Text="CATEGORIES" Foreground="#7F91A8" FontSize="10" FontWeight="SemiBold"/>
                </DockPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,8,12">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding CategoryGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Style="{StaticResource GroupExpander}" IsExpanded="True">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#D8E2EF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Categories.Count}" Foreground="#6F829A" Margin="8,0" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Content="Toggle all" Padding="7,3" Margin="0" FontSize="10" ToolTip="Show or hide all categories in this group"
                            Command="{Binding DataContext.ToggleGroupCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Group}"/>
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Categories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#141C27" CornerRadius="4" Margin="0,2" Padding="8,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible,Mode=TwoWay}"
                                  Command="{Binding DataContext.ToggleCategoryCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                        <Border Grid.Column="1" Background="#202D40" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding ProgressText}" Foreground="#8EA6C2" FontSize="10" ToolTip="Marked / total locations"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsSearchActive,Converter={StaticResource BoolToVisibility}}">
                        <DockPanel Margin="2,0,2,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SearchResults.Count,StringFormat={}{0} found}" Foreground="#6F829A" FontSize="11"/>
                            <TextBlock Text="SEARCH RESULTS" Foreground="#7F91A8" FontSize="10" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Stretch" Padding="10,9" Margin="0,0,0,5"
                        Command="{Binding DataContext.SelectCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding Category.Name}" FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="›" Foreground="#7EAEED" FontSize="18" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
