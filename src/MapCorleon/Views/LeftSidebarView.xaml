<UserControl x:Class="MapCorleon.Views.LeftSidebarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10">
  <DockPanel>
   <TextBox DockPanel.Dock="Top" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search locations, categories, and groups"/>
   <UniformGrid DockPanel.Dock="Top" Columns="3"><Button Content="Marked" Command="{Binding ShowMarkedCommand}"/><Button Content="Unmarked" Command="{Binding ShowUnmarkedCommand}"/><Button Content="All" Command="{Binding ShowAllCommand}"/></UniformGrid>
   <Button DockPanel.Dock="Top" Content="{Binding ProgressText}" Margin="3,8" Click="Progress_Click"/>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate>
     <Expander IsExpanded="True" Margin="3" HorizontalContentAlignment="Stretch"><Expander.Header><Grid MinWidth="210"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="◉" Padding="5,1" ToolTip="Show or hide every category in this group" Command="{Binding DataContext.ToggleGroupCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></Grid></Expander.Header>
      <ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible,Mode=TwoWay}" Command="{Binding DataContext.ToggleCategoryCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </Expander>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel Visibility="{Binding IsSearchActive,Converter={StaticResource BoolToVisibility}}"><Separator/><TextBlock Text="Search results" Foreground="{StaticResource MutedTextBrush}" Margin="5"/>
     <ItemsControl ItemsSource="{Binding SearchResults}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category.Name}" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </StackPanel></ScrollViewer>
  </DockPanel>
 </Border>
</UserControl>
