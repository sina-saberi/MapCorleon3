<UserControl x:Class="MapCorleon.Views.LeftSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="10"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <DockPanel>
            <TextBox DockPanel.Dock="Top"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search locations, categories, and groups" />

            <UniformGrid DockPanel.Dock="Top" Columns="3">
                <UniformGrid.Resources>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Padding" Value="12,7"/>
                        <Setter Property="Margin" Value="3"/>
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="#2D3C52"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="#315B9C"/>
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#79A9F2"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </UniformGrid.Resources>
                <ToggleButton Content="Marked"
                              IsChecked="{Binding IsMarkedFilter, Mode=OneWay}"
                              Command="{Binding ShowMarkedCommand}" />
                <ToggleButton Content="Unmarked"
                              IsChecked="{Binding IsUnmarkedFilter, Mode=OneWay}"
                              Command="{Binding ShowUnmarkedCommand}" />
                <ToggleButton Content="All"
                              IsChecked="{Binding IsAllFilter, Mode=OneWay}"
                              Command="{Binding ShowAllCommand}" />
            </UniformGrid>

            <Button DockPanel.Dock="Top"
                    Margin="3,8"
                    Content="{Binding ProgressText}"
                    Click="Progress_Click" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="3"
                                          HorizontalContentAlignment="Stretch"
                                          IsExpanded="True">
                                    <Expander.Header>
                                        <Grid MinWidth="210">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1"
                                                    Padding="5,1"
                                                    Content="◉"
                                                    ToolTip="Show or hide every category in this group"
                                                    Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Categories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Content="{Binding Name}"
                                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                              Command="{Binding DataContext.ToggleCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="8,0,3,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding ProgressText}"
                                                               ToolTip="Total locations / picked locations"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisibility}}">
                        <Separator />
                        <TextBlock Margin="5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Search results" />
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding Category.Name}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
