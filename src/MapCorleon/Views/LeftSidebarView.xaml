<UserControl x:Class="MapCorleon.Views.LeftSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="10"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <DockPanel>
            <TextBox DockPanel.Dock="Top"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search locations, categories, and groups" />

            <UniformGrid DockPanel.Dock="Top" Columns="3">
                <Button Content="Marked" Command="{Binding ShowMarkedCommand}" />
                <Button Content="Unmarked" Command="{Binding ShowUnmarkedCommand}" />
                <Button Content="All" Command="{Binding ShowAllCommand}" />
            </UniformGrid>

            <Button DockPanel.Dock="Top"
                    Margin="3,8"
                    Content="{Binding ProgressText}"
                    Click="Progress_Click" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="3"
                                          HorizontalContentAlignment="Stretch"
                                          IsExpanded="True">
                                    <Expander.Header>
                                        <Grid MinWidth="210">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1"
                                                    Padding="5,1"
                                                    Content="◉"
                                                    ToolTip="Show or hide every category in this group"
                                                    Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Categories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="8,4"
                                                          Content="{Binding Name}"
                                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          Command="{Binding DataContext.ToggleCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisibility}}">
                        <Separator />
                        <TextBlock Margin="5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Search results" />
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding Category.Name}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
