<UserControl x:Class="MapCorleon.Views.RightSidebarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#7F91A8"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1D2532"/><Setter Property="BorderBrush" Value="#303C4E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
 </UserControl.Resources>
 <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
  <Grid>
   <TextBlock Text="Select a marker to view its details" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedLocation}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" DataContext="{Binding SelectedLocation}">
     <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding DataContext.SelectedLocation,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding Media.Count,Converter={StaticResource CountToVisibility}}">
      <StackPanel>
       <Button x:Name="HeroButton" Margin="0" Padding="0" Click="Hero_Click" ToolTip="Open full-screen gallery">
        <Grid Height="190" Background="#0E131B"><Image x:Name="HeroImage" Stretch="UniformToFill"/><Border VerticalAlignment="Bottom" Background="#B30D121A" Padding="10,7"><DockPanel><TextBlock x:Name="MediaCountText" DockPanel.Dock="Right" Foreground="#CBD5E1"/><TextBlock x:Name="HeroCaption" Foreground="White" TextTrimming="CharacterEllipsis"/></DockPanel></Border></Grid>
       </Button>
       <ListBox x:Name="ThumbnailList" ItemsSource="{Binding Media}" SelectionChanged="Thumbnail_SelectionChanged" BorderThickness="0" Padding="7" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate><Border Width="58" Height="45" Background="#0E131B"><Image Source="{Binding RelativePath}" Stretch="UniformToFill"/></Border></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </Border>
     <TextBlock Text="{Binding Category.Group.Name}" Style="{StaticResource SectionLabel}"/>
     <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="SemiBold" LineHeight="30" TextWrapping="Wrap"/>
     <Border Background="#253248" CornerRadius="10" HorizontalAlignment="Left" Padding="9,4" Margin="0,10,0,16"><TextBlock Text="{Binding Category.Name}" Foreground="#9FC5FF" FontSize="12"/></Border>
     <Border Style="{StaticResource Card}">
      <StackPanel><TextBlock Text="DETAILS" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="DescriptionText" TextWrapping="Wrap" LineHeight="20" Foreground="#D8E0EA"/></StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel><TextBlock Text="LOCATION" Style="{StaticResource SectionLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LATITUDE" FontSize="9" Foreground="#738298"/><TextBlock Text="{Binding Latitude,StringFormat={}{0:F5}}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="LONGITUDE" FontSize="9" Foreground="#738298"/><TextBlock Text="{Binding Longitude,StringFormat={}{0:F5}}" Margin="0,3,0,0"/></StackPanel></Grid></StackPanel>
     </Border>
     <Button Content="◎  Center on map" Click="Move_Click" Background="#315B9C" Padding="12,10"/>
     <UniformGrid Columns="2"><Button Content="{Binding DataContext.MarkActionText,RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.ToggleMarkCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="✎  Edit" Click="Edit_Click" Visibility="{Binding IsCustom,Converter={StaticResource BoolToVisibility}}"/></UniformGrid>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Border>
</UserControl>
