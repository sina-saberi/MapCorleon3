<UserControl x:Class="MapCorleon.Views.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="HeaderAction" TargetType="Button">
      <Setter Property="Foreground" Value="#DCE7F5"/><Setter Property="Background" Value="#202C3F"/>
      <Setter Property="BorderBrush" Value="#34445C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2A3B55"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#4A6385"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#315B9C"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HeaderPrimary" TargetType="Button" BasedOn="{StaticResource HeaderAction}">
      <Setter Property="Background" Value="#315B9C"/><Setter Property="BorderBrush" Value="#5687D1"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Resources>
  <Border BorderBrush="#2C3B52" BorderThickness="0,0,0,1" Padding="14,9">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#121C2B" Offset="0"/><GradientStop Color="#17253A" Offset="0.55"/><GradientStop Color="#101A29" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="42" Height="42" CornerRadius="9" Background="#0E1724" Margin="0,0,11,0">
          <Image Source="/Assets/AppIcon.png" Width="42" Height="42" Stretch="Uniform"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="MapCorleon" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding CurrentMap.DisplayName,TargetNullValue=No map selected}" Foreground="#8FA3BD"
                     FontSize="11" Margin="0,2,0,0" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </StackPanel>

      <Border x:Name="TaskPanel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#182B43" BorderBrush="#345578" BorderThickness="1" CornerRadius="14"
              Padding="12,5" Margin="12,0" Visibility="Collapsed">
        <StackPanel Width="190">
          <DockPanel><TextBlock x:Name="TaskPercent" DockPanel.Dock="Right" Foreground="#8FC4FF" FontSize="11"/>
            <TextBlock x:Name="TaskText" Foreground="#D9E7F7" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <ProgressBar x:Name="TaskProgress" Minimum="0" Maximum="100" Height="3" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="Maps &amp; timelines" Click="Timeline_Click" Style="{StaticResource HeaderAction}"/>
        <Button Content="Downloads" Click="Downloads_Click" Style="{StaticResource HeaderAction}"/>
        <Button x:Name="ImportButton" Content="Import map" Click="Import_Click" Style="{StaticResource HeaderAction}"/>
        <Button Content="+ Add location" Click="Custom_Click" Style="{StaticResource HeaderPrimary}"/>
        <Button Content="⚙" Click="Settings_Click" Style="{StaticResource HeaderAction}" Width="38" Padding="0" ToolTip="Settings"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
