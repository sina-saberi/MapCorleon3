<UserControl x:Class="MapCorleon.Views.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border BorderBrush="#2C3B52" BorderThickness="0,0,0,1" MinHeight="100" ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#172334" Offset="0"/>
        <GradientStop Color="#101925" Offset=".60"/>
        <GradientStop Color="#101721" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*" MaxWidth="840"/></Grid.ColumnDefinitions>
      <Border Grid.Column="1" IsHitTestVisible="False" Opacity=".84">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="Transparent" Offset="0"/>
            <GradientStop Color="#22000000" Offset=".23"/>
            <GradientStop Color="#B8000000" Offset=".58"/>
            <GradientStop Color="Black" Offset="1"/>
          </LinearGradientBrush>
        </Border.OpacityMask>
        <Border.Background>
          <ImageBrush ImageSource="{Binding CurrentGameBanner}" Stretch="UniformToFill" AlignmentX="Right"/>
        </Border.Background>
      </Border>
      <DockPanel Grid.ColumnSpan="2" Margin="19,12">
        <Border x:Name="TaskPanel" DockPanel.Dock="Right" Width="300" Margin="16,0,0,0" Padding="12,6"
                VerticalAlignment="Center" Background="#19283A" BorderBrush="#365171" BorderThickness="1" CornerRadius="6"
                Visibility="{Binding IsRunning,Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding ActiveTaskLabel}" ToolTip="{Binding ActiveTaskLabel}"
                       Foreground="#D6E4F6" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <DockPanel Margin="0,3,0,0">
              <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding Percentage,StringFormat={}{0}%}"
                         FontSize="11" Foreground="#A8C8EE"/>
              <ProgressBar x:Name="TaskProgress" Height="4" VerticalAlignment="Center"
                           Minimum="0" Maximum="100" Value="{Binding Percentage,Mode=OneWay}"
                           AutomationProperties.Name="Download progress"/>
            </DockPanel>
          </StackPanel>
        </Border>
        <DockPanel VerticalAlignment="Center">
          <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="9" Background="#0E1724"
                  BorderBrush="#324157" BorderThickness="1" Margin="0,0,13,0" VerticalAlignment="Center">
            <Image Source="/Assets/AppIcon.png" Width="32" Height="32" Stretch="Uniform"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="MAPCORLEON" Foreground="#91ACCD" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CurrentMap.Name, TargetNullValue=No map selected, FallbackValue=No map selected}"
                       FontSize="23" FontWeight="SemiBold" Foreground="#F4F8FF" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <TextBlock Text="{Binding CurrentMapGameLabel}" Foreground="#A0B1C7" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CurrentMapGameLabel}" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Border Background="#24354C" CornerRadius="8" Padding="7,2"
                      ToolTip="Total locations on this map">
                <Border.Style>
                  <Style TargetType="Border">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CurrentMap}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding TotalCount,StringFormat={}{0:N0} locations}" Foreground="#B6D4FC" FontSize="10"/>
              </Border>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </DockPanel>
    </Grid>
  </Border>
</UserControl>
