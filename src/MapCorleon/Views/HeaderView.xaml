<UserControl x:Class="MapCorleon.Views.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:MapCorleon.Services">
  <UserControl.Resources>
    <Style x:Key="HeaderAction" TargetType="Button">
      <Setter Property="Foreground" Value="#B8C8DB"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#293A51"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#315B9C"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HeaderPrimary" TargetType="Button" BasedOn="{StaticResource HeaderAction}">
      <Setter Property="Background" Value="#3472C4"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#4282D4"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#285D9F"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HeaderIcon" TargetType="Path">
      <Setter Property="Stroke" Value="#DCE7F5"/><Setter Property="StrokeThickness" Value="1.7"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Fill" Value="Transparent"/>
      <Setter Property="Stretch" Value="Uniform"/><Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/>
    </Style>
    <Style x:Key="GameStatusFrame" TargetType="Border">
      <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#202A38"/>
      <Setter Property="BorderBrush" Value="#46566B"/><Setter Property="BorderThickness" Value="1"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding TrackingState}" Value="{x:Static services:PlayerTrackingState.GameNotRunning}">
          <Setter Property="Background" Value="#32251F"/><Setter Property="BorderBrush" Value="#A96E4D"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TrackingState}" Value="{x:Static services:PlayerTrackingState.StartingGame}">
          <Setter Property="Background" Value="#1D3048"/><Setter Property="BorderBrush" Value="#4F83BD"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TrackingState}" Value="{x:Static services:PlayerTrackingState.TrackingPlayer}">
          <Setter Property="Background" Value="#193329"/><Setter Property="BorderBrush" Value="#3E9B70"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TrackingState}" Value="{x:Static services:PlayerTrackingState.PlayerIsInterior}">
          <Setter Property="Background" Value="#352C1D"/><Setter Property="BorderBrush" Value="#A9803F"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TrackingState}" Value="{x:Static services:PlayerTrackingState.UnableToReadLocation}">
          <Setter Property="Background" Value="#391F25"/><Setter Property="BorderBrush" Value="#B65361"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TrackingState}" Value="{x:Static services:PlayerTrackingState.UnsupportedGameVersion}">
          <Setter Property="Background" Value="#30233A"/><Setter Property="BorderBrush" Value="#8D63A8"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="GameStatusIcon" TargetType="Path" BasedOn="{StaticResource HeaderIcon}">
      <Setter Property="Data" Value="M7,12 L17,12 M9,8 L9,16 M15,8 L15,16"/>
      <Setter Property="Stroke" Value="#8999AC"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding TrackingState}" Value="{x:Static services:PlayerTrackingState.GameNotRunning}">
          <Setter Property="Data" Value="M12,3 A9,9 0 1 1 11.99,3 M5.6,5.6 L18.4,18.4"/>
          <Setter Property="Stroke" Value="#E49A6D"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TrackingState}" Value="{x:Static services:PlayerTrackingState.StartingGame}">
          <Setter Property="Data" Value="M12,3 A9,9 0 0 1 21,12 M21,12 L18,9 M21,12 L18,15"/>
          <Setter Property="Stroke" Value="#79B7FA"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TrackingState}" Value="{x:Static services:PlayerTrackingState.TrackingPlayer}">
          <Setter Property="Data" Value="M12,3 L12,7 M12,17 L12,21 M3,12 L7,12 M17,12 L21,12 M12,8 A4,4 0 1 1 11.99,8"/>
          <Setter Property="Stroke" Value="#64D69A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TrackingState}" Value="{x:Static services:PlayerTrackingState.PlayerIsInterior}">
          <Setter Property="Data" Value="M4,11 L12,4 L20,11 M6,10 L6,20 L18,20 L18,10 M10,20 L10,14 L14,14 L14,20"/>
          <Setter Property="Stroke" Value="#E0B45F"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TrackingState}" Value="{x:Static services:PlayerTrackingState.UnableToReadLocation}">
          <Setter Property="Data" Value="M12,3 L22,20 L2,20 Z M12,8 L12,14 M12,17 L12,17.1"/>
          <Setter Property="Stroke" Value="#EF7C87"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TrackingState}" Value="{x:Static services:PlayerTrackingState.UnsupportedGameVersion}">
          <Setter Property="Data" Value="M12,3 A9,9 0 1 1 11.99,3 M8,8 L16,16 M16,8 L8,16"/>
          <Setter Property="Stroke" Value="#CB93EC"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Border BorderBrush="#2C3B52" BorderThickness="0,0,0,1" Padding="14,9">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#121C2B" Offset="0"/><GradientStop Color="#17253A" Offset="0.55"/><GradientStop Color="#101A29" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="42" Height="42" CornerRadius="9" Background="#0E1724" Margin="0,0,11,0">
          <Image Source="/Assets/AppIcon.png" Width="42" Height="42" Stretch="Uniform"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="MapCorleon" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding CurrentMap.DisplayName,TargetNullValue=No map selected}" Foreground="#8FA3BD"
                     FontSize="11" Margin="0,2,0,0" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </StackPanel>

      <Border x:Name="TaskPanel" Grid.Column="1" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#182B43" BorderBrush="#345578" BorderThickness="1" CornerRadius="19"
              Margin="12,0" Visibility="Collapsed">
        <Grid>
          <Path Data="M6,4 L18,4 L18,20 L6,20 Z M9,8 L15,8 M9,12 L15,12 M9,16 L13,16"
                Style="{StaticResource HeaderIcon}" Width="18" Height="18" Stroke="#8FC4FF" Margin="0,0,0,3"/>
          <ProgressBar x:Name="TaskProgress" Minimum="0" Maximum="100" Height="3" Margin="6,0" VerticalAlignment="Bottom"/>
        </Grid>
      </Border>

      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Border Style="{StaticResource GameStatusFrame}" ToolTip="{Binding PlayerTrackingStatusText}">
          <Path Style="{StaticResource GameStatusIcon}"/>
        </Border>
        <Border Background="#192537" BorderBrush="#2C3D54" BorderThickness="1" CornerRadius="8" Padding="3">
          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding LaunchGameCommand}" Style="{StaticResource HeaderAction}" ToolTip="Launch game"
                    AutomationProperties.Name="Launch game"
                    Visibility="{Binding IsPlayerTrackingSupported,Converter={StaticResource BoolToVisibility}}">
              <Path Data="M8,5 L19,12 L8,19 Z" Fill="#C8D7E9" StrokeThickness="0" Stretch="Uniform" Width="17" Height="17"/>
            </Button>
            <Border Width="1" Height="18" Background="#34465F" Margin="3,0" VerticalAlignment="Center"
                    Visibility="{Binding IsPlayerTrackingSupported,Converter={StaticResource BoolToVisibility}}"/>
            <Button Click="Timeline_Click" Style="{StaticResource HeaderAction}" ToolTip="Maps and timelines"
                    AutomationProperties.Name="Maps and timelines">
              <Path Data="M3,5 L8,3 L16,5 L21,3 L21,19 L16,21 L8,19 L3,21 Z M8,3 L8,19 M16,5 L16,21"
                    Style="{StaticResource HeaderIcon}"/>
            </Button>
            <Button Click="Downloads_Click" Style="{StaticResource HeaderAction}" ToolTip="Downloads"
                    AutomationProperties.Name="Downloads">
              <Path Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,20 L20,20" Style="{StaticResource HeaderIcon}"/>
            </Button>
            <Button x:Name="ImportButton" Click="Import_Click" Style="{StaticResource HeaderAction}" ToolTip="Import map"
                    AutomationProperties.Name="Import map">
              <Path Data="M5,4 L17,4 L17,9 M5,4 L5,20 L17,20 L17,15 M21,12 L10,12 M14,8 L10,12 L14,16"
                    Style="{StaticResource HeaderIcon}"/>
            </Button>
            <Border Width="1" Height="18" Background="#34465F" Margin="3,0" VerticalAlignment="Center"/>
            <Button x:Name="CustomButton" Click="Custom_Click" Style="{StaticResource HeaderPrimary}" ToolTip="Add location"
                    AutomationProperties.Name="Add location">
              <Path Data="M12,21 C12,21 5,14.5 5,9 A7,7 0 1 1 19,9 C19,14.5 12,21 12,21 Z M12,6 L12,12 M9,9 L15,9"
                    Style="{StaticResource HeaderIcon}" Stroke="White" Width="18" Height="18"/>
            </Button>
            <Button Click="Settings_Click" Style="{StaticResource HeaderAction}" ToolTip="Settings"
                    AutomationProperties.Name="Settings">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                         Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
