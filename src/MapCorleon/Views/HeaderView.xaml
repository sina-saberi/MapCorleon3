<UserControl x:Class="MapCorleon.Views.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Padding="10" Background="#172033">
    <DockPanel>
      <TextBlock Text="MapCorleon" Foreground="White" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <StackPanel x:Name="TaskPanel" Width="210" Margin="6,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="TaskText" Foreground="#D9E4F2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <ProgressBar x:Name="TaskProgress" Minimum="0" Maximum="100" Height="5" Margin="0,4,0,0"/>
        </StackPanel>
        <Button Content="Settings" Click="Settings_Click"/>
        <Button x:Name="ImportButton" Content="Import Map" Click="Import_Click"/>
        <Button Content="Downloads" Click="Downloads_Click"/>
        <Button Content="Timelines &amp; Maps" Click="Timeline_Click"/>
        <Button Content="+ Custom Location" Click="Custom_Click"/>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
