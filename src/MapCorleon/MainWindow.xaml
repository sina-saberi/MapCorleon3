<Window x:Class="MapCorleon.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MapCorleon.Views" Title="MapCorleon" Icon="Assets/AppIcon.ico" Width="1400" Height="850" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen">
 <Grid Background="{StaticResource WindowBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <views:HeaderView Grid.Row="0"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition/><ColumnDefinition>
    <ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="340"/>
      <Style.Triggers><DataTrigger Binding="{Binding SelectedLocation}" Value="{x:Null}"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers>
    </Style></ColumnDefinition.Style>
   </ColumnDefinition></Grid.ColumnDefinitions>
   <views:LeftSidebarView Grid.Column="0"/><views:MapView x:Name="DesktopMap" Grid.Column="1"/><views:RightSidebarView Grid.Column="2"/>
  </Grid>
  <Border Background="#88000000" Visibility="{Binding IsLoading,Converter={StaticResource BoolToVisibility}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="240" Height="8"/><TextBlock Text="Loading…" Foreground="White" FontSize="16" Margin="0,12" HorizontalAlignment="Center"/></StackPanel></Border>
 </Grid>
</Window>
